# LLM provider. Swap by editing LLM_PROVIDER + LLM_MODEL below, and filling
# in the matching *_API_KEY. The other keys can stay blank.
#
# Suggested combos:
#   groq        + llama-3.3-70b-versatile           free, fast, generous limits
#   gemini      + gemini-2.0-flash                  free tier strict, needs billing
#   openrouter  + meta-llama/llama-3.3-70b-instruct paid pay-as-you-go
#   openai      + gpt-4o-mini                       paid pay-as-you-go
#   ollama      + qwen2.5:7b                        local, no API key required

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Qdrant (local via docker-compose by default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=open-energy

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Langfuse (optional, leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ingestion
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=40

# API
HOST=0.0.0.0
PORT=8000
RELOAD=true
