# LLM provider (groq | openrouter | gemini | openai | ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Qdrant (local via docker-compose by default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=open-energy

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Langfuse (optional, leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ingestion
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=40

# API
HOST=0.0.0.0
PORT=8000
RELOAD=true
